###############################################################################
# ComplyEasyAI — Complete Environment Variable Reference
# Copy to .env and fill in your actual values
# Variables marked [REQUIRED] must be set for the app to start
# Variables marked [OPTIONAL] have sensible defaults
###############################################################################

# ─── Core Server ─────────────────────────────────────────────────────────────
NODE_ENV=development                          # [REQUIRED] development | production | test
PORT=3001                                     # [OPTIONAL] Server port (default: 3001)
API_URL=http://localhost:3001                 # [REQUIRED] Public API base URL
CLIENT_URL=http://localhost:3000              # [REQUIRED] Frontend URL (CORS, redirects)

# ─── Database (PostgreSQL / Supabase) ────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://user:password@localhost:5432/complyeasy?schema=public"  # [REQUIRED]

# ─── Redis Cache & Job Queue ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379              # [OPTIONAL] Full Redis URL (takes precedence)
REDIS_HOST=localhost                          # [OPTIONAL] Redis host (fallback if REDIS_URL not set)

# ─── JWT Authentication ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING           # [REQUIRED]
JWT_EXPIRES_IN=7d                                           # [OPTIONAL] Access token TTL
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING   # [REQUIRED]
JWT_REFRESH_EXPIRES_IN=30d                                  # [OPTIONAL] Refresh token TTL

# ─── Encryption (2FA, BYOK) ─────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_THIS_TO_A_64_CHARACTER_HEX_STRING    # [REQUIRED]

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api                     # [REQUIRED] API URL for frontend
VITE_SUPABASE_URL=https://your-project.supabase.co         # [OPTIONAL] Supabase project URL
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key              # [OPTIONAL] Supabase anon key

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE                    # [REQUIRED] Powers AI compliance copilot

# ─── OpenAI (Whisper Transcription) ─────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE                    # [OPTIONAL] Required for audio/video transcription

# ─── SendGrid Email ──────────────────────────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE                # [REQUIRED] Email notifications
SENDGRID_FROM_EMAIL=noreply@yourdomain.com                 # [REQUIRED] Sender email
SENDGRID_FROM_NAME=ComplyEasy AI                           # [OPTIONAL] Sender display name

# ─── Twilio SMS Notifications ───────────────────────────────────────────────
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID                 # [OPTIONAL] Required for SMS alerts
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN                    # [OPTIONAL] Twilio auth token
TWILIO_PHONE_NUMBER=+15551234567                           # [OPTIONAL] Twilio sender phone number

# ─── Stripe Payments ────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY           # [REQUIRED] Stripe secret key
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY # [REQUIRED] Stripe publishable key
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET            # [REQUIRED] Stripe webhook signing secret

# Stripe Price IDs — create in Stripe Dashboard → Products
STRIPE_BASIC_PRICE_ID=price_YOUR_BASIC_PRICE_ID            # [REQUIRED]
STRIPE_PRO_PRICE_ID=price_YOUR_PRO_PRICE_ID                # [REQUIRED]
STRIPE_ENTERPRISE_PRICE_ID=price_YOUR_ENTERPRISE_PRICE_ID  # [REQUIRED]

# Stripe Tiered Pricing (annual/monthly)
STRIPE_FOUNDATION_MONTHLY_PRICE_ID=price_foundation_monthly    # [OPTIONAL]
STRIPE_FOUNDATION_ANNUAL_PRICE_ID=price_foundation_annual      # [OPTIONAL]
STRIPE_ESSENTIALS_MONTHLY_PRICE_ID=price_essentials_monthly    # [OPTIONAL]
STRIPE_ESSENTIALS_ANNUAL_PRICE_ID=price_essentials_annual      # [OPTIONAL]
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_growth_monthly            # [OPTIONAL]
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_growth_annual              # [OPTIONAL]
STRIPE_VISIONARY_MONTHLY_PRICE_ID=price_visionary_monthly      # [OPTIONAL]
STRIPE_VISIONARY_ANNUAL_PRICE_ID=price_visionary_annual        # [OPTIONAL]

# Stripe Add-on Price IDs
STRIPE_ADDON_VCISO_PRICE_ID=price_addon_vciso                 # [OPTIONAL]
STRIPE_ADDON_CUSTOM_FRAMEWORKS_PRICE_ID=price_addon_frameworks # [OPTIONAL]
STRIPE_ADDON_AUDIT_BUNDLING_PRICE_ID=price_addon_audit         # [OPTIONAL]
STRIPE_ADDON_CUSTOM_AI_PRICE_ID=price_addon_ai                 # [OPTIONAL]
STRIPE_ADDON_ON_PREM_PRICE_ID=price_addon_onprem               # [OPTIONAL]

# ─── AWS S3 File Storage ────────────────────────────────────────────────────
# Get from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID                    # [REQUIRED] S3 evidence storage
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY            # [REQUIRED]
AWS_REGION=us-east-1                                        # [REQUIRED]
AWS_S3_BUCKET=your-complyeasy-bucket                        # [REQUIRED]
AWS_ACCOUNT_ID=123456789012                                 # [OPTIONAL] For CDK deployments
SCAN_TEMP_BUCKET=your-scan-temp-bucket                      # [OPTIONAL] Malware scan staging

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID                      # [OPTIONAL]
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET              # [OPTIONAL]
GOOGLE_CALLBACK_URL=http://localhost:5000/api/integrations/google/callback
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json # [OPTIONAL] GCP service account
GOOGLE_VISION_API_KEY=YOUR_GOOGLE_VISION_KEY                # [OPTIONAL] Evidence image analysis
GCP_PROJECT_ID=your-gcp-project-id                          # [OPTIONAL]

# ─── GitHub OAuth & Webhooks ────────────────────────────────────────────────
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID                      # [OPTIONAL]
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET              # [OPTIONAL]
GITHUB_CALLBACK_URL=http://localhost:5000/api/integrations/github/callback
GITHUB_TOKEN=YOUR_GITHUB_PAT                                # [OPTIONAL] Compliance-as-Code repo access
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET            # [OPTIONAL]

# ─── GitLab ─────────────────────────────────────────────────────────────────
GITLAB_TOKEN=YOUR_GITLAB_PAT                                # [OPTIONAL] Compliance-as-Code GitLab integration

# ─── Slack OAuth ─────────────────────────────────────────────────────────────
# Get from: https://api.slack.com/apps
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID                        # [OPTIONAL]
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET                # [OPTIONAL]
SLACK_CALLBACK_URL=http://localhost:5000/api/integrations/slack/callback
SLACK_DEFAULT_CHANNEL=compliance-alerts                     # [OPTIONAL]

# ─── Jira OAuth ──────────────────────────────────────────────────────────────
# Get from: https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID=YOUR_JIRA_CLIENT_ID                          # [OPTIONAL]
JIRA_CLIENT_SECRET=YOUR_JIRA_CLIENT_SECRET                  # [OPTIONAL]
JIRA_CALLBACK_URL=http://localhost:5000/api/integrations/jira/callback

# ─── Blockchain (Ethereum / Polygon) ────────────────────────────────────────
# Ethereum RPC: https://infura.io or https://alchemy.com
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID     # [OPTIONAL]
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_PRIVATE_KEY                          # [OPTIONAL] Deployer wallet
COMPLIANCE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000  # [OPTIONAL] Deployed contract
COMPLIANCE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000  # [OPTIONAL]
DEPLOY_NETWORK=localhost                                           # [OPTIONAL] localhost | goerli | mainnet | polygon | mumbai
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY                           # [OPTIONAL] Contract verification
GAS_PRICE_MULTIPLIER=1.2                                           # [OPTIONAL]

# Polygon network
POLYGON_RPC_URL=https://polygon-rpc.com                            # [OPTIONAL]
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY                       # [OPTIONAL]
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com                   # [OPTIONAL]
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_PROJECT_ID        # [OPTIONAL]

# Blockchain role addresses (comma-separated Ethereum addresses)
ADMIN_ADDRESSES=0xAdmin1,0xAdmin2                                  # [OPTIONAL]
AUDITOR_ADDRESSES=0xAuditor1                                       # [OPTIONAL]
OPERATOR_ADDRESSES=0xOperator1                                     # [OPTIONAL]
ATTESTATION_SECRET=YOUR_ATTESTATION_SECRET                         # [OPTIONAL]

# ─── Hyperledger Fabric ──────────────────────────────────────────────────────
HYPERLEDGER_PEER_ENDPOINT=grpcs://localhost:7051                   # [OPTIONAL]
HYPERLEDGER_CHANNEL_NAME=compliance-channel                        # [OPTIONAL]
HYPERLEDGER_CHAINCODE_NAME=compliance-cc                           # [OPTIONAL]
HYPERLEDGER_MSP_ID=Org1MSP                                         # [OPTIONAL]
HYPERLEDGER_WALLET_PATH=./wallet                                   # [OPTIONAL]
HYPERLEDGER_PRIVATE_KEY=                                           # [OPTIONAL]
HYPERLEDGER_USER_PRIVATE_KEY_PEM=                                  # [OPTIONAL]
HYPERLEDGER_PEER_TLS_CERT_PATH=                                    # [OPTIONAL]
HYPERLEDGER_PEER_TLS_KEY_PATH=                                     # [OPTIONAL]
HYPERLEDGER_PEER_TLS_CA_CERT_PATH=                                 # [OPTIONAL]

# ─── LDAP / Active Directory ────────────────────────────────────────────────
LDAP_URL=ldap://localhost:389                                      # [OPTIONAL]
LDAP_BASE_DN=dc=example,dc=com                                    # [OPTIONAL]
LDAP_BIND_DN=cn=admin,dc=example,dc=com                           # [OPTIONAL]
LDAP_BIND_PASSWORD=YOUR_LDAP_BIND_PASSWORD                         # [OPTIONAL]
LDAP_USE_TLS=false                                                 # [OPTIONAL]
LDAP_TLS_REJECT_UNAUTHORIZED=true                                  # [OPTIONAL]
LDAP_POOL_SIZE=5                                                   # [OPTIONAL]
LDAP_CONNECT_TIMEOUT=5000                                          # [OPTIONAL] ms
LDAP_SEARCH_TIMEOUT=10000                                          # [OPTIONAL] ms
LDAP_RECONNECT_INTERVAL=5000                                       # [OPTIONAL] ms
LDAP_CACHE_TTL_MS=300000                                           # [OPTIONAL] 5 min cache

# ─── WebRTC (VR Collaborative Review) ───────────────────────────────────────
WEBRTC_SIGNALING_SERVER=wss://your-signaling-server.com            # [OPTIONAL]
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302                  # [OPTIONAL]
WEBRTC_TURN_URL=turn:your-turn-server.com:3478                    # [OPTIONAL]
WEBRTC_TURN_TLS_URL=turns:your-turn-server.com:5349               # [OPTIONAL]
TURN_SERVER_URL=turn:your-turn-server.com:3478                     # [OPTIONAL]
TURN_USERNAME=YOUR_TURN_USERNAME                                   # [OPTIONAL]
TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL                               # [OPTIONAL]
WEBRTC_TURN_TTL=86400                                              # [OPTIONAL] seconds
WEBRTC_RELAY_ONLY=false                                            # [OPTIONAL]
WEBRTC_CUSTOM_STUN_URL=                                            # [OPTIONAL]
WEBRTC_EXTRA_TURN_URLS=                                            # [OPTIONAL]
TWILIO_TURN_URL=                                                   # [OPTIONAL] Twilio TURN service

# ─── MQTT (Physical AI / IoT Devices) ───────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883                              # [OPTIONAL]
MQTT_USERNAME=YOUR_MQTT_USERNAME                                   # [OPTIONAL]
MQTT_PASSWORD=YOUR_MQTT_PASSWORD                                   # [OPTIONAL]
MQTT_CLIENT_ID=complyeasy-server                                   # [OPTIONAL]

# ─── OPA (Open Policy Agent) ────────────────────────────────────────────────
OPA_ENDPOINT=http://localhost:8181                                 # [OPTIONAL]
OPA_AUTH_TOKEN=YOUR_OPA_TOKEN                                      # [OPTIONAL]

# ─── HashiCorp Vault (Secret Management) ────────────────────────────────────
VAULT_ADDR=http://localhost:8200                                   # [OPTIONAL]
VAULT_TOKEN=YOUR_VAULT_TOKEN                                       # [OPTIONAL]

# ─── Whisper / Speaker Diarization ──────────────────────────────────────────
# OPENAI_API_KEY is set above
PYANNOTE_SERVICE_URL=http://localhost:8001                         # [OPTIONAL] pyannote.audio diarization

# ─── EU AI Act Database Integration ─────────────────────────────────────────
EU_AI_DB_API_BASE_URL=https://api.euaiact-db.eu                   # [OPTIONAL]
EU_AI_DB_CLIENT_ID=YOUR_EU_AI_DB_CLIENT_ID                         # [OPTIONAL]
EU_AI_DB_CLIENT_SECRET=YOUR_EU_AI_DB_CLIENT_SECRET                 # [OPTIONAL]
EU_AI_DB_ORG_ID=YOUR_EU_AI_DB_ORG_ID                               # [OPTIONAL]

# ─── NVD (National Vulnerability Database) ───────────────────────────────────
NVD_API_KEY=YOUR_NVD_API_KEY                                       # [OPTIONAL]

# ─── Firmware Registry (Physical AI) ────────────────────────────────────────
FIRMWARE_REGISTRY_URL=https://firmware.example.com                 # [OPTIONAL]

# ─── Security Scanning ──────────────────────────────────────────────────────
VIRUS_SCAN_METHOD=clamav                                           # [OPTIONAL] clamav | virustotal
CLAMAV_HOST=localhost                                              # [OPTIONAL] ClamAV daemon host
VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_API_KEY                         # [OPTIONAL]
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_API_KEY                           # [OPTIONAL] IP reputation
KNOWN_MALICIOUS_IPS=                                               # [OPTIONAL] Comma-separated

# ─── Deepfake / Liveness Detection ──────────────────────────────────────────
DEEPFAKE_THRESHOLD=0.7                                             # [OPTIONAL]
DEEPFAKE_MAX_FRAMES=30                                             # [OPTIONAL]
DEEPFAKE_FRAME_INTERVAL=5                                          # [OPTIONAL]
LIVENESS_THRESHOLD=0.5                                             # [OPTIONAL]
LIVENESS_EAR_THRESHOLD=0.25                                        # [OPTIONAL]
LIVENESS_EAR_OPEN=0.3                                              # [OPTIONAL]

# ─── Monitoring & APM ───────────────────────────────────────────────────────
# Sentry: https://sentry.io/settings/projects/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/123                  # [OPTIONAL]
SENTRY_ENABLED=false                                               # [OPTIONAL]
SENTRY_TRACES_SAMPLE_RATE=0.1                                     # [OPTIONAL]
SENTRY_PROFILES_SAMPLE_RATE=0.1                                   # [OPTIONAL]

# Elastic APM
ELASTIC_APM_SERVER_URL=http://localhost:8200                       # [OPTIONAL]
ELASTIC_APM_SECRET_TOKEN=YOUR_APM_SECRET                           # [OPTIONAL]
ELASTIC_APM_API_KEY=YOUR_APM_API_KEY                               # [OPTIONAL]
ELASTIC_APM_SAMPLE_RATE=0.1                                        # [OPTIONAL]
APM_ENABLED=false                                                  # [OPTIONAL]
APM_SERVICE_NAME=complyeasy-api                                    # [OPTIONAL]
ENABLE_REAL_MONITORING=false                                       # [OPTIONAL]

# New Relic
NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_KEY                            # [OPTIONAL]

# ─── Elasticsearch ───────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200                             # [OPTIONAL]
ELASTICSEARCH_USERNAME=elastic                                     # [OPTIONAL]
ELASTICSEARCH_PASSWORD=YOUR_ES_PASSWORD                             # [OPTIONAL]
ELASTICSEARCH_ENABLED=false                                        # [OPTIONAL]
ELASTICSEARCH_INDEX_PREFIX=complyeasy                              # [OPTIONAL]
ELASTICSEARCH_LOG_LEVEL=info                                       # [OPTIONAL]
ELASTICSEARCH_SSL_REJECT_UNAUTHORIZED=true                         # [OPTIONAL]

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info                                                     # [OPTIONAL] error | warn | info | debug
LOG_CONSOLE=true                                                   # [OPTIONAL]
LOG_FILE=false                                                     # [OPTIONAL]

# ─── Rate Limiting & Security ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000                                        # [OPTIONAL] 15 minutes
RATE_LIMIT_MAX_REQUESTS=100                                        # [OPTIONAL] per window
CORS_ORIGIN=http://localhost:3000                                  # [REQUIRED]

# ─── Session Management ─────────────────────────────────────────────────────
SESSION_TIMEOUT=3600000                                            # [OPTIONAL] 1 hour in ms
SESSION_WARNING_TIME=300000                                        # [OPTIONAL] 5 min warning
SESSION_CLEANUP_INTERVAL=600000                                    # [OPTIONAL] 10 min cleanup
MAX_CONCURRENT_SESSIONS=5                                          # [OPTIONAL]

# ─── NTP (Time Synchronization) ─────────────────────────────────────────────
NTP_SERVER=pool.ntp.org                                            # [OPTIONAL]
NTP_PORT=123                                                       # [OPTIONAL]
TSA_URL=http://timestamp.digicert.com                              # [OPTIONAL] Timestamp authority

# ─── Mobile App ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:5000/api                      # [OPTIONAL] React Native

# ─── Multi-Region Deployment ────────────────────────────────────────────────
DEPLOY_REGION=us-east-1                                            # [OPTIONAL]
DEPLOY_NETWORKS=us-east,eu-central                                 # [OPTIONAL] Comma-separated
DEPLOYMENT_STATE_PATH=./deployment-state.json                      # [OPTIONAL]
ENABLE_CROSS_REGION_HEALTH=false                                   # [OPTIONAL]

# US East
US_EAST_API_URL=https://us-east.complyeasy.ai/api                 # [OPTIONAL]
US_EAST_DATABASE_URL=postgresql://...                              # [OPTIONAL]
US_EAST_REDIS_URL=redis://...                                      # [OPTIONAL]
US_EAST_S3_BUCKET=complyeasy-us-east                               # [OPTIONAL]

# US West
US_WEST_API_URL=https://us-west.complyeasy.ai/api                 # [OPTIONAL]
US_WEST_DATABASE_URL=postgresql://...                              # [OPTIONAL]
US_WEST_REDIS_URL=redis://...                                      # [OPTIONAL]
US_WEST_S3_BUCKET=complyeasy-us-west                               # [OPTIONAL]

# EU Central
EU_CENTRAL_API_URL=https://eu-central.complyeasy.ai/api           # [OPTIONAL]
EU_CENTRAL_DATABASE_URL=postgresql://...                           # [OPTIONAL]
EU_CENTRAL_REDIS_URL=redis://...                                   # [OPTIONAL]
EU_CENTRAL_S3_BUCKET=complyeasy-eu-central                         # [OPTIONAL]

# EU West
EU_WEST_API_URL=https://eu-west.complyeasy.ai/api                 # [OPTIONAL]
EU_WEST_DATABASE_URL=postgresql://...                              # [OPTIONAL]
EU_WEST_REDIS_URL=redis://...                                      # [OPTIONAL]
EU_WEST_S3_BUCKET=complyeasy-eu-west                               # [OPTIONAL]

# AP Northeast
AP_NORTHEAST_API_URL=https://ap-northeast.complyeasy.ai/api       # [OPTIONAL]
AP_NORTHEAST_DATABASE_URL=postgresql://...                         # [OPTIONAL]
AP_NORTHEAST_REDIS_URL=redis://...                                 # [OPTIONAL]
AP_NORTHEAST_S3_BUCKET=complyeasy-ap-northeast                     # [OPTIONAL]

# AP Southeast
AP_SOUTHEAST_API_URL=https://ap-southeast.complyeasy.ai/api       # [OPTIONAL]
AP_SOUTHEAST_DATABASE_URL=postgresql://...                         # [OPTIONAL]
AP_SOUTHEAST_REDIS_URL=redis://...                                 # [OPTIONAL]
AP_SOUTHEAST_S3_BUCKET=complyeasy-ap-southeast                     # [OPTIONAL]

# ─── Database Pool Configuration ─────────────────────────────────────────────
DB_POOL_SIZE=10                                                     # [OPTIONAL] Connection pool size (default: 10)
DB_POOL_TIMEOUT=20                                                  # [OPTIONAL] Pool timeout in seconds (default: 20)

# ─── Blockchain / Smart Contract ─────────────────────────────────────────────
# PRIVATE_KEY=                                                      # [OPTIONAL] Deployer wallet private key (alias for BLOCKCHAIN_PRIVATE_KEY)
COMPLIANCE_CONTRACT_BYTECODE=                                       # [OPTIONAL] Smart contract bytecode for compliance contract deployment
BLOCKCHAIN_AUDIT_ORG_ID=                                            # [OPTIONAL] Organization ID for blockchain audit operations

# ─── WebRTC / Real-time Collaboration ────────────────────────────────────────
WEBRTC_TURN_SECRET=                                                 # [OPTIONAL] TURN server credential generation secret

# ─── MDM (Mobile Device Management) ─────────────────────────────────────────
MDM_PROVIDER_URL=                                                   # [OPTIONAL] MDM provider API URL (e.g., Jamf, Intune endpoint)

# ─── E2E Testing ─────────────────────────────────────────────────────────────
# E2E_BASE_URL=http://localhost:3000                               # [TEST ONLY]
# TEST_USER_EMAIL=test@example.com                                 # [TEST ONLY]
# TEST_USER_PASSWORD=testpassword123                               # [TEST ONLY]
