  aiFeatureUsed         Boolean @default(false)
  firstReportGenerated  Boolean @default(false)

  // Growth-tier specific
  acosConfigured       Boolean @default(false)
  digitalTwinActivated Boolean @default(false)

  // Enterprise GRC modules
  riskHeatmapViewed             Boolean @default(false)
  regulatoryTrackerViewed       Boolean @default(false)
