  estimatedDuration Int?
  actualDuration    Int?
  deadline          DateTime?
  timeoutAt         DateTime?
  retryCount        Int                   @default(0)
  maxRetries        Int                   @default(3)
  result            Json?
  error             String?
  metrics           Json?                 @default("{}")
  createdAt         DateTime              @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime              @default(now()) @updatedAt
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentTask        SwarmTask?            @relation("SwarmTaskHierarchy", fields: [parentTaskId], references: [id])
  childTasks        SwarmTask[]           @relation("SwarmTaskHierarchy")
  checkpoints       SwarmTaskCheckpoint[]

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([taskType])
  @@index([parentTaskId])
  @@index([deadline])
  @@index([createdAt])
}

model SwarmTaskCheckpoint {
  id          String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  taskId      String
  agentId     String?
  progress    Float     @default(0)
  state       Json      @default("{}")
  description String?
  timestamp   DateTime  @default(now())
  task        SwarmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([timestamp])
}

model UserSession {
  id                 String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
