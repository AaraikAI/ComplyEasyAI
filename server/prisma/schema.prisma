// EU AI Act (Regulation 2024/1689)
model EUAIActSystem {
  id                       String                      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId           String
  name                     String
  description              String?                     @db.Text
  riskLevel                String // unacceptable, high, limited, minimal
  highRiskCategory         String? // critical_infrastructure, education_training, etc.
  isGeneralPurpose         Boolean                     @default(false)
  isGenerative             Boolean                     @default(false)
  prohibitedPractices      String[] // Array of prohibited practice types
  transparencyRequirements Json // AI labeling, copyright, illegal content prevention
  complianceStatus         String                      @default("in_review") // compliant, non_compliant, in_review, at_risk
  lastAssessmentDate       DateTime?
  nextAssessmentDate       DateTime?
  registeredInEUDatabase   Boolean                     @default(false)
  euDatabaseRegistrationId String?
  createdBy                String
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  organization             Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  riskAssessments          EUAIActRiskAssessment[]
  transparencyReports      EUAIActTransparencyReport[]

  @@index([organizationId])
  @@index([riskLevel])
  @@index([complianceStatus])
  @@index([highRiskCategory])
  @@index([registeredInEUDatabase])
}

model EUAIActRiskAssessment {
  id                 String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  systemId           String
  organizationId     String
  assessedBy         String
  assessmentDate     DateTime      @default(now())
  riskLevel          String
  findings           Json // safetyRisks, fundamentalRightsRisks, discriminationRisks, privacyRisks
  mitigationMeasures String[]
  complianceScore    Int // 0-100
  recommendations    String[]
  status             String        @default("pending") // pending, approved, rejected, requires_action
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  system             EUAIActSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@index([organizationId])
  @@index([assessmentDate])
  @@index([status])
}

model EUAIActTransparencyReport {
  id                          String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId              String
  reportingPeriodStart        DateTime
  reportingPeriodEnd          DateTime
  generativeAISystems         Json // Array of system reports
  highRiskSystems             Json // Array of high-risk system reports
  prohibitedPracticesDetected Int            @default(0)
  complaintsReceived          Int            @default(0)
  complaintsResolved          Int            @default(0)
  submittedToCommission       Boolean        @default(false)
  submittedAt                 DateTime?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  organization                Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  EUAIActSystem               EUAIActSystem? @relation(fields: [eUAIActSystemId], references: [id])
  eUAIActSystemId             String?

  @@index([organizationId])
  @@index([reportingPeriodStart])
  @@index([reportingPeriodEnd])
  @@index([submittedToCommission])
}

// Digital Markets Act (DMA) - Regulation 2022/1925
model DMAGatekeeper {
  id                   String                  @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId       String
  platformName         String
  corePlatformServices String[] // Array of CPS types
  designationDate      DateTime?
  designationStatus    String                  @default("not_designated") // not_designated, designated, under_review
  annualRevenue        Decimal?                @db.Decimal(15, 2)
  marketCapitalization Decimal?                @db.Decimal(15, 2)
  monthlyActiveUsers   Int?
  obligations          Json // Array of DMA obligations
  complianceStatus     String                  @default("in_review") // compliant, non_compliant, in_review
  lastReviewDate       DateTime?
  nextReviewDate       DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  complianceReports    DMAComplianceReport[]
  obligationsTracking  DMAObligationTracking[]

  @@index([organizationId])
  @@index([designationStatus])
  @@index([complianceStatus])
}

model DMAComplianceReport {
  id                    String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  gatekeeperId          String
  organizationId        String
  reportingPeriod       Json // start, end dates
  obligationsStatus     Json // Status of each obligation
  violations            Json? // Any violations detected
  remediation           Json? // Remediation actions taken
  submittedToCommission Boolean       @default(false)
  submittedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  gatekeeper            DMAGatekeeper @relation(fields: [gatekeeperId], references: [id], onDelete: Cascade)

  @@index([gatekeeperId])
  @@index([organizationId])
  @@index([submittedToCommission])
}

model DMAObligationTracking {
  id                    String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  gatekeeperId          String
  organizationId        String
  obligationType        String // Article number or obligation name
  obligationDescription String        @db.Text
  complianceStatus      String        @default("pending") // pending, compliant, non_compliant, in_progress
  evidence              Json? // Evidence of compliance
  lastVerified          DateTime?
  nextReviewDate        DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  gatekeeper            DMAGatekeeper @relation(fields: [gatekeeperId], references: [id], onDelete: Cascade)

  @@index([gatekeeperId])
  @@index([organizationId])
  @@index([obligationType])
  @@index([complianceStatus])
}

// Digital Services Act (DSA) - Regulation 2022/2065
model DSAPlatform {
  id                    String                    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId        String
  platformName          String
  platformType          String // online_platform, very_large_online_platform, very_large_search_engine
  monthlyActiveUsers    Int?
  isVLOP                Boolean                   @default(false) // Very Large Online Platform (>45M users)
  isVLOSE               Boolean                   @default(false) // Very Large Online Search Engine
  designationDate       DateTime?
  complianceStatus      String                    @default("in_review") // compliant, non_compliant, in_review
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentModeration     DSAContentModeration[]
  transparencyReports   DSATransparencyReport[]
  illegalContentReports DSAIllegalContentReport[]
  adRepositories        DSAAdRepository[]
  riskAssessments       DSARiskAssessment[]
  nonPersonalizedFeed   DSANonPersonalizedFeed?

  @@index([organizationId])
  @@index([platformType])
  @@index([isVLOP])
  @@index([isVLOSE])
  @@index([complianceStatus])
}

model DSAContentModeration {
  id                String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  platformId        String
  organizationId    String
  actionType        String // removal, suspension, restriction, appeal
  contentType       String // post, comment, video, image, etc.
  reason            String      @db.Text
  automatedDecision Boolean     @default(false)
  appealAvailable   Boolean     @default(true)
  appealStatus      String? // pending, approved, rejected
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  platform          DSAPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([organizationId])
  @@index([actionType])
  @@index([createdAt])
}

model DSATransparencyReport {
  id                     String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  platformId             String
  organizationId         String
  reportingPeriodStart   DateTime
  reportingPeriodEnd     DateTime
  contentModerationStats Json // removals, suspensions, appeals, etc.
  userReports            Json // User-reported content statistics
  trustedFlaggerReports  Json? // Trusted flagger statistics
  automatedDetection     Json? // Automated content detection stats
  appealsProcessed       Json? // Appeals statistics
  submittedToCommission  Boolean     @default(false)
  submittedAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  platform               DSAPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([organizationId])
  @@index([reportingPeriodStart])
  @@index([submittedToCommission])
}

model DSAIllegalContentReport {
  id               String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  platformId       String
  organizationId   String
  reportedBy       String // user_id or "trusted_flagger"
  isTrustedFlagger Boolean     @default(false)
  contentType      String
  contentUrl       String?     @db.Text
  reason           String      @db.Text
  status           String      @default("pending") // pending, reviewed, action_taken, dismissed
  actionTaken      String? // removal, restriction, no_action
  responseTime     Int? // Hours to respond
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  platform         DSAPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([organizationId])
  @@index([status])
  @@index([isTrustedFlagger])
  @@index([createdAt])
}

model DSAAdRepository {
  id                 String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  platformId         String
  organizationId     String
  adId               String
  advertiserName     String
  adContent          Json // Ad content details
  targetingCriteria  Json? // Targeting parameters
  displayPeriod      Json // start, end dates
  impressions        Int?
  clicks             Int?
  isPoliticalAd      Boolean     @default(false)
  isTargetedToMinors Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  platform           DSAPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([organizationId])
  @@index([advertiserName])
  @@index([isPoliticalAd])
  @@index([displayPeriod])
}

model DSARiskAssessment {
  id                    String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  platformId            String
  organizationId        String
  assessmentDate        DateTime    @default(now())
  assessedBy            String
  riskCategory          String // illegal_content, fundamental_rights, public_security, protection_of_minors
  systemicRisks         Json // Detailed risk findings
  illegalContentRisks   Json? // Specific risks related to illegal content
  fundamentalRightsRisks Json? // Risks to fundamental rights
  publicSecurityRisks   Json? // Public security concerns
  protectionOfMinorsRisks Json? // Risks to protection of minors
  overallRiskLevel      String // low, medium, high, critical
  mitigationMeasures     Json // Array of mitigation measures with status
  nextReviewDate        DateTime?
  status                String      @default("draft") // draft, in_review, approved, requires_action
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  platform              DSAPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@index([organizationId])
  @@index([assessmentDate])
  @@index([riskCategory])
  @@index([status])
  @@index([overallRiskLevel])
}

model DSANonPersonalizedFeed {
  id                    String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  platformId            String
  organizationId        String
  isEnabled             Boolean     @default(false)
  implementationDate    DateTime?
  userOptInMethod       String // toggle, settings_page, onboarding
  feedAlgorithmType     String // chronological, popularity, random
  description           String?     @db.Text
  userDocumentationUrl  String?     @db.Text
  technicalSpecs        Json? // Technical implementation details
  complianceStatus      String      @default("not_implemented") // not_implemented, in_progress, implemented, compliant
  lastAuditDate         DateTime?
  notes                 String?     @db.Text
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  platform              DSAPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId])
  @@index([organizationId])
  @@index([isEnabled])
  @@index([complianceStatus])
}
