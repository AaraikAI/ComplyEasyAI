// --- Data Protection Impact Assessment (GDPR Art. 35) ---
model DataProtectionImpactAssessment {
  id                    String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId        String
  title                 String
  description           String?
  processingActivity    String       // What processing is being assessed
  dataCategories        String[]     // PersonalData, SpecialCategory, Financial, etc.
  specialCategories     Boolean      @default(false)
  dataSubjects          String[]     // Employees, Customers, Children, etc.
  necessity             String?      // Why processing is necessary
  proportionality       String?      // Why processing is proportionate
  lawfulBasis           String?      // Legal basis for processing
  screeningResult       String       @default("Required") // Required, NotRequired, Uncertain
  status                String       @default("Draft") // Draft, InProgress, UnderReview, Approved, Rejected
  overallRiskLevel      String?      // Low, Medium, High, VeryHigh
  riskMitigations       Json?        // Array of mitigation measures
  dpoConsulted          Boolean      @default(false)
  dpoConsultationDate   DateTime?
  dpoOpinion            String?
  dpoName               String?
  supervisoryAuthority  Boolean      @default(false) // Art. 36 prior consultation
  approvedBy            String?
  approvedAt            DateTime?
  nextReviewDate        DateTime?
  createdBy             String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  riskAssessments       DPIARiskAssessment[]
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([screeningResult])
}

model DPIARiskAssessment {
  id                    String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  dpiaId                String
  riskCategory          String       // DataBreach, UnauthorizedAccess, DataLoss, etc.
  riskDescription       String
  likelihood            String       // VeryLow, Low, Medium, High, VeryHigh
  impact                String       // VeryLow, Low, Medium, High, VeryHigh
  riskLevel             String       // Calculated: Low, Medium, High, VeryHigh
  existingControls      String[]
  proposedMitigations   String[]
  residualRisk          String?      // After mitigations
  status                String       @default("Identified") // Identified, Mitigated, Accepted, Transferred
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  dpia                  DataProtectionImpactAssessment @relation(fields: [dpiaId], references: [id], onDelete: Cascade)

  @@index([dpiaId])
  @@index([riskLevel])
}

// --- Records of Processing Activities (GDPR Art. 30) ---
model ProcessingActivityRecord {
