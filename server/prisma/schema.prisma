generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String                @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name                 String
  plan                 Plan                  @default(Basic)
  stripeCustomerId     String?               @unique
  subscriptionStatus   SubscriptionStatus    @default(trialing)
  parentOrganizationId String?
  isParent             Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  accessReviews        AccessReview[]
  auditLogs            AuditLog[]
  frameworks           ComplianceFramework[]
  monitors             ContinuousMonitor[]
  reports              CustomReport[]
  integrations         Integration[]
  issues               Issue[]
  parentOrganization   Organization?         @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations   Organization[]        @relation("OrgHierarchy")
  personnel            Personnel[]
  policies             Policy[]
  questionnaires       Questionnaire[]
  riskAssessments      RiskAssessment[]
  risks                RiskItem[]
  trustCertificates    TrustCertificate[]
  users                User[]
  vendors              Vendor[]
  complianceGoals      ComplianceGoal[]
  controlLoops         ControlLoop[]
  controlLoopHistory   ControlLoopHistory[]
  complianceDebts      ComplianceDebt[]
  changeImpacts        ChangeImpact[]
  agenticActions       AgenticAction[]
  evidenceAnalyses     EvidenceAnalysis[]
  regulatoryChanges    RegulatoryChange[]
  riskPredictions      RiskPrediction[]
  complianceTrajectories ComplianceTrajectory[]
  simulationScenarios  SimulationScenario[]
  simulationResults    SimulationResult[]
  redTeamResults       RedTeamResult[]
  swarmInsights        SwarmInsight[]
  iotDevices           IoTDevice[]
  edgeComplianceChecks EdgeComplianceCheck[]
  transcriptionResults TranscriptionResult[]
  deviceTrusts         DeviceTrust[]
  zeroTrustPolicies    ZeroTrustPolicy[]
  networkSegments      NetworkSegment[]
  keyUsages            KeyUsage[]
  keyRotationPolicies  KeyRotationPolicy[]
  compliancePolicies   CompliancePolicy[]

  @@index([stripeCustomerId])
  @@index([parentOrganizationId])
}

model User {
  id                    String                @id @default(dbgenerated("(uuid_generate_v4())::text"))
  email                 String                @unique
  name                  String
  role                  Role                  @default(viewer)
  avatar                String?
  passwordHash          String?
  emailVerified         Boolean               @default(false)
  lastLogin             DateTime?
  employeeId            String?               @unique
  department            String?
  jobTitle              String?
  manager               String?
  startDate             DateTime?
  endDate               DateTime?
  active                Boolean               @default(true)
  twoFactorEnabled      Boolean               @default(false)
  twoFactorSecret       String?
  twoFactorVerified     Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt
  organizationId        String
  accessReviewsReviewer AccessReview[]        @relation("Reviewer")
  auditLogs             AuditLog[]
  assignedIssues        Issue[]               @relation("AssignedTo")
  createdIssues         Issue[]               @relation("CreatedBy")
  personnelRecord       Personnel?
  assignedRisks         RiskItem[]
  backupCodes           TwoFactorBackupCode[]
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@index([employeeId])
}

model TwoFactorBackupCode {
  id        String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  code      String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

model Personnel {
  id                  String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId              String         @unique
  organizationId      String
  onboardingStatus    String         @default("Not_Started")
  onboardingDate      DateTime?
  offboardingDate     DateTime?
  offboardingReason   String?
  systemAccess        Json?
  dataAccess          Json?
  physicalAccess      Json?
  backgroundCheck     Boolean        @default(false)
  backgroundCheckDate DateTime?
  securityTraining    Boolean        @default(false)
  trainingDate        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt
  accessReviews       AccessReview[]
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model AccessReview {
  id             String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  personnelId    String
  reviewerId     String
  status         AccessReviewStatus @default(Pending)
  dueDate        DateTime
  completedDate  DateTime?
  findings       Json?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personnel      Personnel          @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  reviewer       User               @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([organizationId])
  @@index([personnelId])
  @@index([status])
}

model Vendor {
  id                 String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name               String
  organizationId     String
  website            String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  riskLevel          VendorRiskLevel    @default(Medium)
  riskScore          Int                @default(0)
  status             VendorStatus       @default(Onboarding)
  category           String?
  serviceDescription String?
  contractStart      DateTime?
  contractEnd        DateTime?
  annualSpend        Float?
  hasDataAccess      Boolean            @default(false)
  dataTypes          Json?
  securityContact    String?
  lastSecurityReview DateTime?
  nextSecurityReview DateTime?
  soc2Report         Boolean            @default(false)
  iso27001Certified  Boolean            @default(false)
  gdprCompliant      Boolean            @default(false)
  hipaaBaa           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessments        VendorAssessment[]
  monitors           VendorMonitor[]
  reviews            VendorReview[]

  @@index([organizationId])
  @@index([status])
  @@index([riskLevel])
}

model VendorAssessment {
  id              String           @id @default(dbgenerated("(uuid_generate_v4())::text"))
  vendorId        String
  assessmentType  String
  status          String           @default("In_Progress")
  score           Int?
  riskLevel       VendorRiskLevel?
  findings        Json?
  recommendations String?
  assessedBy      String?
  assessedDate    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorReview {
  id             String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  vendorId       String
  reviewType     String
  reviewDate     DateTime
  reviewer       String
  findings       Json?
  actionItems    Json?
  nextReviewDate DateTime?
  createdAt      DateTime  @default(now())
  vendor         Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorMonitor {
  id          String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  vendorId    String
  monitorType String
  status      MonitorStatus @default(Unknown)
  lastCheck   DateTime?
  findings    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  vendor      Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
}

model RiskAssessment {
  id               String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId   String
  name             String
  description      String?
  assessmentType   String
  scope            String?
  methodology      String?
  status           String       @default("Draft")
  startDate        DateTime?
  completedDate    DateTime?
  overallRiskScore Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risks            RiskItem[]   @relation("AssessmentRisks")

  @@index([organizationId])
  @@index([status])
}

model ComplianceFramework {
  id             String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name           String
  status         ComplianceStatus   @default(In_Review)
  progress       Int                @default(0)
  nextAuditDate  DateTime
  region         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controls       FrameworkControl[]
  complianceDebts ComplianceDebt[]
  complianceTrajectories ComplianceTrajectory[]

  @@index([organizationId])
  @@index([status])
}

model FrameworkControl {
  id             String              @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name           String
  description    String?
  status         String              @default("Pending")
  evidence       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  frameworkId    String
  mappedControls Json?
  framework      ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  controlLoops   ControlLoop[]
  complianceDebts ComplianceDebt[] @relation("ComplianceDebtControl")

  @@index([frameworkId])
}

model RiskItem {
  id               String          @id @default(dbgenerated("(uuid_generate_v4())::text"))
  title            String
  severity         RiskSeverity
  description      String
  category         String
  status           RiskStatus      @default(Open)
  likelihood       Int             @default(3)
  impact           Int             @default(3)
  riskScore        Int?
  aiPriorityScore  Int?
  aiRationale      String?
  mitigationPlan   String?
  remediationOwner String?
  targetDate       DateTime?
  detectedAt       DateTime        @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  organizationId   String
  assignedToId     String?
  assessmentId     String?
  assessment       RiskAssessment? @relation("AssessmentRisks", fields: [assessmentId], references: [id])
  assignedTo       User?           @relation(fields: [assignedToId], references: [id])
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  riskPredictions  RiskPrediction[]

  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([assignedToId])
  @@index([assessmentId])
}

model Questionnaire {
  id                String                  @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId    String
  title             String
  description       String?
  questionnaireType String
  status            QuestionnaireStatus     @default(Draft)
  requestedBy       String?
  requestDate       DateTime?
  dueDate           DateTime?
  aiAssisted        Boolean                 @default(false)
  aiConfidence      Float?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @default(now()) @updatedAt
  completedAt       DateTime?
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questions         QuestionnaireQuestion[]
  responses         QuestionnaireResponse[]

  @@index([organizationId])
  @@index([status])
}

model QuestionnaireQuestion {
  id              String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  questionnaireId String
  questionText    String
  questionType    String
  category        String?
  required        Boolean       @default(false)
  options         Json?
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
}

model QuestionnaireResponse {
  id              String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  questionnaireId String
  questionId      String
  responseText    String?
  responseData    Json?
  aiGenerated     Boolean       @default(false)
  aiConfidence    Float?
  reviewedByHuman Boolean       @default(false)
  attachments     Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
  @@index([questionId])
}

model Policy {
  id              String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId  String
  title           String
  policyNumber    String?
  version         String       @default("1.0")
  category        String
  framework       String?
  content         String
  summary         String?
  status          String       @default("Draft")
  owner           String?
  approver        String?
  approvalDate    DateTime?
  effectiveDate   DateTime?
  reviewDate      DateTime?
  nextReviewDate  DateTime?
  tags            Json?
  relatedPolicies Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([framework])
}

model TrustCertificate {
  id                String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId    String
  certificateType   String
  certificateNumber String?
  issuer            String
  issueDate         DateTime
  expiryDate        DateTime
  status            String       @default("Valid")
  documentUrl       String?
  publiclyVisible   Boolean      @default(false)
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model CustomReport {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  name           String
  description    String?
  reportType     String
  template       Json
  filters        Json?
  schedule       Json?
  lastGenerated  DateTime?
  nextGeneration DateTime?
  recipients     Json?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([reportType])
}

model ContinuousMonitor {
  id             String          @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  name           String
  monitorType    String
  integrationId  String?
  configuration  Json
  testScript     String?
  status         MonitorStatus   @default(Unknown)
  lastRun        DateTime?
  nextRun        DateTime?
  frequency      String          @default("Daily")
  findings       Json?
  alerts         Json?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  results        MonitorResult[]

  @@index([organizationId])
  @@index([status])
  @@index([monitorType])
}

model MonitorResult {
  id                 String            @id @default(dbgenerated("(uuid_generate_v4())::text"))
  monitorId          String
  status             MonitorStatus
  runDate            DateTime          @default(now())
  passedTests        Int               @default(0)
  failedTests        Int               @default(0)
  findings           Json?
  evidence           Json?
  autoRemediated     Boolean           @default(false)
  remediationActions Json?
  monitor            ContinuousMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([status])
}

model Issue {
  id               String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId   String
  title            String
  description      String
  issueType        String
  category         String?
  priority         IssuePriority  @default(Medium)
  status           IssueStatus    @default(Open)
  assignedToId     String?
  createdById      String
  slaTarget        DateTime?
  slaStatus        String?
  remediationPlan  String?
  remediationSteps Json?
  dueDate          DateTime?
  resolvedDate     DateTime?
  closedDate       DateTime?
  tags             Json?
  attachments      Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  assignedTo       User?          @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy        User           @relation("CreatedBy", fields: [createdById], references: [id])
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments         IssueComment[]

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
}

model IssueComment {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  issueId   String
  comment   String
  author    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model AuditLog {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  action         String
  details        String?
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  hash           String       @unique
  verified       Boolean      @default(true)
  timestamp      DateTime     @default(now())
  organizationId String
  userId         String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([timestamp])
  @@index([hash])
  @@index([action])
  @@index([resourceType])
  @@index([userId])
}

model Integration {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name           String
  category       String
  provider       String
  connected      Boolean      @default(false)
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  lastSync       DateTime?
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model MagicLink {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

model FileUpload {
  id             String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  filename       String
  originalName   String
  mimeType       String
  size           Int
  s3Key          String   @unique
  s3Bucket       String
  url            String
  uploadedBy     String
  organizationId String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([uploadedBy])
  @@index([s3Key])
}

model StripeEvent {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  eventId   String   @unique
  type      String
  data      Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([type])
  @@index([processed])
}

enum Role {
  admin
  editor
  viewer
  compliance_admin
  security_admin
}

enum ComplianceStatus {
  Compliant
  At_Risk
  Non_Compliant
  In_Review
}

enum RiskSeverity {
  Critical
  High
  Medium
  Low
}

enum RiskStatus {
  Open
  In_Progress
  Resolved
  Ignored
  Accepted
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
}

enum Plan {
  Basic
  Pro
  Enterprise
}

enum AccessReviewStatus {
  Pending
  In_Progress
  Completed
  Overdue
}

enum VendorRiskLevel {
  Critical
  High
  Medium
  Low
}

enum VendorStatus {
  Active
  Inactive
  Onboarding
  Offboarding
  Suspended
}

enum QuestionnaireStatus {
  Draft
  In_Progress
  Completed
  Reviewed
  Approved
}

enum IssueStatus {
  Open
  In_Progress
  Resolved
  Closed
  Reopened
}

enum IssuePriority {
  Critical
  High
  Medium
  Low
}

enum MonitorStatus {
  Passing
  Failing
  Warning
  Unknown
}

// aCOS v3.0 Models
model ComplianceGoal {
  id              String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId  String
  name            String?
  goalType        String
  frameworks      String[]
  riskTolerance   String
  horizon         Int
  autoActionPolicy String
  targetScore     Int?
  deadline        DateTime?
  status          String   @default("active")
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model ControlLoop {
  id            String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  controlId     String
  observeAgent String
  actAgent     String
  verifyAgent  String
  confidence   Float    @default(0.5)
  status       String   @default("active")
  lastObserved DateTime @default(now())
  lastActed    DateTime @default(now())
  lastVerified DateTime @default(now())
  cycleCount   Int      @default(0)
  triggerType   String?  @default("manual")
  triggerConfig Json?
  timeoutSeconds Int?    @default(300)
  parentLoopId  String?
  configuration Json?
  lastError      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control      FrameworkControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  history      ControlLoopHistory[]

  @@index([organizationId])
  @@index([controlId])
  @@index([status])
  @@index([triggerType])
  @@index([parentLoopId])
}

model ControlLoopHistory {
  id            String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  loopId        String
  organizationId String
  executionPhase String
  phaseResult   Json
  durationMs    Int
  success       Boolean  @default(true)
  error         String?
  timestamp     DateTime @default(now())
  loop          ControlLoop @relation(fields: [loopId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([loopId])
  @@index([organizationId])
  @@index([timestamp])
}

model ComplianceDebt {
  id                      String    @id @default(uuid())
  organizationId          String
  frameworkId             String
  controlId               String?   // Link to control
  debtType                String
  severity                String
  description             String
  estimatedRemediationHours Int
  deadline                DateTime? // Optional deadline
  accumulatedAt           DateTime  @default(now())
  resolvedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework               ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  control                 FrameworkControl? @relation("ComplianceDebtControl", fields: [controlId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([frameworkId])
  @@index([severity])
  @@index([controlId])
  @@index([deadline])
}

model ChangeImpact {
  id                      String    @id @default(uuid())
  organizationId          String
  changeType              String
  changeId                String
  affectedControls        String[]
  affectedFrameworks      String[]
  downstreamDependencies  String[]  @default([])
  impactScore             Int
  riskIncrease            Float
  estimatedComplianceChange Float
  severity                String?
  estimatedResolutionDays Int?
  resolvedAt              DateTime?
  forecastedAt            DateTime  @default(now())
  createdAt               DateTime  @default(now())
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([changeType])
  @@index([severity])
  @@index([resolvedAt])
}

model AgenticAction {
  id              String    @id @default(uuid())
  organizationId  String
  actionType      String
  targetId        String
  parameters      Json
  blastRadius     Json
  requiresApproval Boolean  @default(false)
  status          String    @default("pending")
  rollbackData    Json?
  executedAt      DateTime?
  rolledBackAt    DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([actionType])
}

model EvidenceAnalysis {
  id                  String    @id @default(uuid())
  evidenceId          String
  organizationId      String
  deepfakeScore       Float
  cryptographicHash   String
  physicalAttestation Json?
  humanLiveness       Json?
  overallConfidence   Float
  verificationStatus  String
  analyzedAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
  @@index([organizationId])
  @@index([verificationStatus])
}

model RegulatoryChange {
  id                    String    @id @default(uuid())
  organizationId        String
  regulationName        String
  jurisdiction          String
  effectiveDate         DateTime
  changeType            String
  affectedFrameworks    String[]
  extractedRequirements String[]
  autoGeneratedControls Json?
  status                String    @default("pending")
  regulationText        String?   @db.Text
  source                String?
  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([jurisdiction])
  @@index([status])
}

model RiskPrediction {
  id                  String    @id @default(uuid())
  organizationId      String
  riskId             String?
  riskType           String
  predictedProbability Float
  predictedSeverity  String
  predictedDate       DateTime
  confidence         Float
  factors            String[]
  timeHorizonMonths  Int
  createdAt          DateTime  @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk               RiskItem? @relation(fields: [riskId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([predictedDate])
  @@index([predictedSeverity])
}

model ComplianceTrajectory {
  id                String    @id @default(uuid())
  organizationId    String
  frameworkId       String
  currentScore      Int
  predictedScores   Json
  trend             String
  timeHorizonMonths Int
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework         ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([frameworkId])
}

model SimulationScenario {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  description     String
  scenarioType    String
  parameters      Json
  createdBy       String
  createdAt       DateTime  @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  results         SimulationResult[]

  @@index([organizationId])
  @@index([scenarioType])
}

model SimulationResult {
  id                    String    @id @default(uuid())
  scenarioId            String
  organizationId        String
  baselineScore         Int
  simulatedScore        Int
  scoreChange           Int
  affectedControls      Int
  affectedFrameworks    Int
  riskChanges           Json
  confidence            Float
  recommendations       String[]
  createdAt             DateTime  @default(now())
  scenario              SimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@index([organizationId])
}

model RedTeamResult {
  id                        String    @id @default(uuid())
  organizationId            String
  scenarioId                String
  success                   Boolean
  attackPath                String[]
  vulnerabilitiesFound      Json
  remediationRecommendations String[]
  executionTime             Int
  createdBy                 String
  createdAt                 DateTime  @default(now())
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
}

model SwarmInsight {
  id                    String    @id @default(uuid())
  organizationId        String
  insightType           String
  description           String    @db.Text
  confidence            Float
  sourceCount           Int
  applicableFrameworks  String[]
  recommendations       String[]
  createdAt             DateTime  @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([insightType])
}

model IoTDevice {
  id                String    @id @default(uuid())
  organizationId    String
  deviceId          String
  deviceType        String
  location          String
  complianceStatus  String    @default("unknown")
  lastSeen          DateTime  @default(now())
  sensorData        Json?
  mqttTopic         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  complianceChecks  EdgeComplianceCheck[]

  @@unique([deviceId, organizationId])
  @@index([organizationId])
  @@index([complianceStatus])
}

model EdgeComplianceCheck {
  id              String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  deviceId        String
  organizationId  String
  checkType       String
  status          String
  severity        String?   @default("medium")
  details         String
  timestamp       DateTime  @default(now())
  device          IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([organizationId])
  @@index([timestamp])
}

model TranscriptionResult {
  id              String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId  String
  evidenceId      String?
  text            String    @db.Text
  confidence      Float
  language        String
  duration        Int?
  segments        Json?
  sourceType      String
  createdAt       DateTime  @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([evidenceId])
  @@index([sourceType])
}

// Zero Trust Security Models
model DeviceTrust {
  id            String    @id @default(uuid())
  deviceId      String
  organizationId String
  deviceType    String
  fingerprint   String
  trustScore    Float
  isTrusted     Boolean   @default(false)
  lastVerified  DateTime  @default(now())
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([deviceId, organizationId])
  @@index([organizationId])
  @@index([deviceId])
  @@index([isTrusted])
}

model ZeroTrustPolicy {
  id            String    @id @default(uuid())
  organizationId String
  name          String
  description   String    @db.Text
  rules         Json
  enabled       Boolean   @default(true)
  priority      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([enabled])
}

model NetworkSegment {
  id            String    @id @default(uuid())
  organizationId String
  name          String
  cidr          String?
  resources     Json
  trustLevel    String    @default("medium")
  policies      Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([trustLevel])
}

// BYOK Key Usage Tracking
model KeyUsage {
  id            String    @id @default(uuid())
  organizationId String
  keyId         String
  provider      String    // aws_kms, azure_kv, gcp_kms, hashicorp_vault
  operation     String    // encrypt, decrypt, generate
  dataSize      Int?      // Size of data in bytes
  success       Boolean   @default(true)
  errorMessage  String?
  metadata      Json?
  timestamp     DateTime  @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyId])
  @@index([provider])
  @@index([timestamp])
  @@index([operation])
}

// Key Rotation Policies
model KeyRotationPolicy {
  id            String    @id @default(uuid())
  organizationId String
  keyId         String
  provider      String
  rotationIntervalDays Int @default(90)
  lastRotation  DateTime?
  nextRotation  DateTime
  autoRotate    Boolean   @default(false)
  notifyDaysBefore Int    @default(7)
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([keyId, organizationId])
  @@index([organizationId])
  @@index([nextRotation])
  @@index([enabled])
}

// Compliance-as-Code Policy Storage
model CompliancePolicy {
  id            String    @id @default(uuid())
  organizationId String
  name          String
  framework     String    // SOC2, ISO27001, HIPAA, etc.
  rego          String    @db.Text // OPA Rego policy code
  severity      String    @default("high") // critical, high, medium, low
  tags          String[]
  version       Int       @default(1)
  previousVersionId String?
  enabled       Boolean   @default(true)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  previousVersion CompliancePolicy? @relation("PolicyVersions", fields: [previousVersionId], references: [id])
  nextVersions   CompliancePolicy[] @relation("PolicyVersions")

  @@index([organizationId])
  @@index([framework])
  @@index([severity])
  @@index([enabled])
  @@index([version])
}
