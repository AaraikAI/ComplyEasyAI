  id                  String            @id @default(uuid())
  firstName           String
  lastName            String
  email               String
  company             String
  jobTitle            String?
  phone               String?
  companySize         String? // e.g., '1-10', '11-50', '51-200', '201-1000', '1000+'
  industry            String?
  country             String?
  interestedTier      String? // Which tier they're interested in
  currentChallenge    String? // Their main compliance challenge
  howDidYouHear       String? // Marketing attribution
  message             String? // Additional notes/questions
  status              DemoRequestStatus @default(pending)
  scheduledAt         DateTime? // When the demo is scheduled
  completedAt         DateTime? // When the demo was completed
  assignedTo          String? // Sales rep assigned
  welcomeEmailSentAt  DateTime? // When welcome email was sent via webhook
  followUpEmailSentAt DateTime? // When follow-up email was sent
  notes               String? // Internal notes
  source              String? // e.g., 'pricing_page', 'landing_page', 'referral'
  utmSource           String? // UTM parameters for tracking
  utmMedium           String?
  utmCampaign         String?
  ipAddress           String? // For basic fraud prevention
  userAgent           String? // Browser info
  referrer            String? // Where they came from
  convertedToUserId   String? // If they sign up, link to user
  convertedAt         DateTime? // When they converted to a user
  metadata            Json? // Additional custom data
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@index([company])
  @@index([interestedTier])
  @@index([createdAt])
  @@index([scheduledAt])
}

// Feature subscriptions for a-la-carte feature sales
model FeatureSubscription {
  id                       String             @id @default(uuid())
  organizationId           String
  featureId                String // Feature ID from features catalog
  status                   SubscriptionStatus @default(active)
  billingCycle             BillingCycle       @default(annual)
  price                    Decimal            @db.Decimal(10, 2) // Calculated price based on tier
  stripeSubscriptionItemId String?            @unique // Stripe subscription item ID
  stripePriceId            String? // Stripe price ID
  startsAt                 DateTime           @default(now())
  endsAt                   DateTime? // For cancelled subscriptions
  cancelledAt              DateTime? // When cancellation was requested
  cancelAtPeriodEnd        Boolean            @default(false)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureId, status])
  @@index([organizationId])
  @@index([featureId])
  @@index([status])
  @@index([stripeSubscriptionItemId])
}

enum DemoRequestStatus {
  pending // Just submitted
  contacted // Initial outreach made
  scheduled // Demo scheduled
  completed // Demo completed
  qualified // Qualified lead
  proposal_sent // Proposal sent
  negotiation // In negotiation
  converted // Converted to customer
  disqualified // Not a fit
  no_response // No response after follow-up
}

model ControlMapping {
  id              String           @id @default(dbgenerated("(uuid_generate_v4())::text"))
  sourceControlId String
  targetControlId String
  mappingType     String           @default("equivalent") // 'equivalent', 'related', 'superset', 'subset'
  confidence      Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  sourceControl   FrameworkControl @relation("SourceMappings", fields: [sourceControlId], references: [id], onDelete: Cascade)
  targetControl   FrameworkControl @relation("TargetMappings", fields: [targetControlId], references: [id], onDelete: Cascade)

  @@unique([sourceControlId, targetControlId])
  @@index([sourceControlId])
  @@index([targetControlId])
}

model AISuggestion {
  id             String              @id @default(dbgenerated("(uuid_generate_v4())::text"))
  frameworkId    String
  fileName       String
  fileUrl        String
  s3Key          String
  classification String
  description    String?
  confidence     Float
  status         AISuggestionStatus  @default(pending)
  feedback       String? // User feedback when rejected
  controlId      String? // Created control ID if accepted
  suggestedBy    String
  organizationId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  framework      ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  suggester      User                @relation(fields: [suggestedBy], references: [id], onDelete: Restrict)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control        FrameworkControl?   @relation(fields: [controlId], references: [id], onDelete: SetNull)

  @@index([frameworkId])
  @@index([status])
  @@index([organizationId])
  @@index([suggestedBy])
  @@index([createdAt])
}

enum AISuggestionStatus {
  pending
  accepted
  rejected
}

model EvidenceVersion {
  id            String           @id @default(dbgenerated("(uuid_generate_v4())::text"))
  controlId     String
  versionNumber Int
  fileUrl       String
  fileName      String
  uploadedBy    String?
  uploadedAt    DateTime         @default(now())
  fileSize      BigInt?
  mimeType      String?
  isCurrent     Boolean          @default(false)
  control       FrameworkControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  uploader      User?            @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([controlId])
  @@index([controlId, versionNumber])
}

model ChatConversation {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  userId         String
  messages       Json         @default("[]")
  fileContext    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

// ============================================================================
// NIST AI RMF 1.0 Models
// ============================================================================

model AISystem {
  id                             String                               @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId                 String
  name                           String
  description                    String?                              @db.Text
  systemType                     String // e.g., "Machine Learning", "Generative AI", "Decision Support"
  useCase                        String?                              @db.Text
  deploymentContext              String? // e.g., "Healthcare", "Finance", "Manufacturing"
  lifecycleStage                 String                               @default("Plan_and_Design") // Plan_and_Design, Collect_and_Process, Build_and_Validate, Deploy_and_Operate, Monitor_and_Maintain
  autonomyLevel                  String                               @default("Human_in_Loop") // Fully_Autonomous, Human_in_Loop, Human_Override, Fully_Manual
  status                         String                               @default("In_Development") // In_Development, Deployed, Retired, Under_Review
  riskLevel                      String? // Critical, High, Medium, Low
  overallTrustworthinessScore    Int? // 0-100
  metadata                       Json?
  createdAt                      DateTime                             @default(now())
  updatedAt                      DateTime                             @updatedAt
  organization                   Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coreFunctions                  AIRMFCoreFunction[]
  trustworthinessCharacteristics AIRMFTrustworthinessCharacteristic[]
  lifecycleStages                AIRMFLifecycleStage[]
  actors                         AIRMFActor[]
  assessments                    AIRMFAssessment[]
  profiles                       AIRMFProfile[]
  riskActivities                 AIRMFRiskActivity[]

  @@index([organizationId])
  @@index([status])
  @@index([lifecycleStage])
  @@index([riskLevel])
}

model AIRMFCoreFunction {
  id                String          @id @default(dbgenerated("(uuid_generate_v4())::text"))
  aiSystemId        String
  functionName      String // GOVERN, MAP, MEASURE, MANAGE
  description       String?         @db.Text
  status            String          @default("Not_Started") // Not_Started, In_Progress, Completed, Under_Review
  completionPercent Int             @default(0)
  lastAssessed      DateTime?
  categories        AIRMFCategory[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  aiSystem          AISystem        @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)

  @@unique([aiSystemId, functionName])
  @@index([aiSystemId])
  @@index([functionName])
  @@index([status])
}

model AIRMFCategory {
  id                String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  coreFunctionId    String
  categoryId        String // e.g., "GOV-1", "MAP-1", "MEAS-1", "MAN-1"
  name              String
  description       String?            @db.Text
  status            String             @default("Not_Started")
  completionPercent Int                @default(0)
  subcategories     AIRMFSubcategory[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  coreFunction      AIRMFCoreFunction  @relation(fields: [coreFunctionId], references: [id], onDelete: Cascade)

  @@unique([coreFunctionId, categoryId])
  @@index([coreFunctionId])
  @@index([categoryId])
  @@index([status])
}

model AIRMFSubcategory {
  id            String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  categoryId    String
  subcategoryId String // e.g., "GOV-1.1", "MAP-1.1"
  name          String
  description   String?       @db.Text
  status        String        @default("Not_Started") // Not_Started, In_Progress, Completed, Non_Applicable
  evidence      String?       @db.Text
  evidenceUrl   String?
  ownerId       String?
  notes         String?       @db.Text
  lastReviewed  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  category      AIRMFCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  owner         User?         @relation("AIRMFSubcategoryOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([categoryId, subcategoryId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([ownerId])
}

model AIRMFTrustworthinessCharacteristic {
  id              String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  aiSystemId      String
  characteristic  String // Valid_and_Reliable, Safe, Secure_and_Resilient, Accountable_and_Transparent, Explainable_and_Interpretable, Privacy_Enhanced, Fair_with_Bias_Managed
  description     String?   @db.Text
  score           Int? // 0-100
  status          String    @default("Not_Assessed") // Not_Assessed, Assessed, Needs_Improvement, Compliant
  assessmentNotes String?   @db.Text
  lastAssessed    DateTime?
  evidence        Json? // Evidence and documentation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  aiSystem        AISystem  @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)

  @@unique([aiSystemId, characteristic])
  @@index([aiSystemId])
  @@index([characteristic])
  @@index([status])
}

model AIRMFLifecycleStage {
  id             String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  aiSystemId     String
  stage          String // Plan_and_Design, Collect_and_Process, Build_and_Validate, Deploy_and_Operate, Monitor_and_Maintain
  status         String    @default("Not_Started")
  startDate      DateTime?
  completionDate DateTime?
  notes          String?   @db.Text
  risks          Json? // Risks identified at this stage
  activities     Json? // Activities performed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  aiSystem       AISystem  @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)

  @@unique([aiSystemId, stage])
  @@index([aiSystemId])
  @@index([stage])
  @@index([status])
}

model AIRMFActor {
  id                String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  aiSystemId        String
  actorType         String // Developer, Operator, Evaluator, Decision_Maker, End_User, Regulator, etc.
  userId            String? // Link to User if applicable
  name              String
  role              String
  responsibilities  String[] @default([])
  involvementStages String[] @default([]) // Lifecycle stages where this actor is involved
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  aiSystem          AISystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  user              User?    @relation("AIRMFActorUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([aiSystemId])
  @@index([actorType])
  @@index([userId])
}

model AIRMFAssessment {
  id                   String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  aiSystemId           String
  assessmentType       String // Initial, Periodic, Post_Incident, Pre_Deployment
  assessedBy           String
  assessmentDate       DateTime  @default(now())
  overallScore         Int? // 0-100
  functionScores       Json? // Scores for each core function
  characteristicScores Json? // Scores for each trustworthiness characteristic
  findings             Json? // Assessment findings
  recommendations      String[]  @default([])
  status               String    @default("Draft") // Draft, Completed, Approved
  approvedBy           String?
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  aiSystem             AISystem  @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)

  @@index([aiSystemId])
  @@index([assessmentType])
  @@index([assessmentDate])
  @@index([status])
}

model AIRMFProfile {
  id                String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  aiSystemId        String
  profileName       String // e.g., "High-Risk Healthcare AI", "Consumer-Facing AI", "Internal Decision Support"
  profileType       String // Context_Profile, Sector_Profile, Use_Case_Profile
  description       String?  @db.Text
  selectedFunctions Json // Selected functions, categories, and subcategories
  priorities        Json? // Prioritized risks and characteristics
  customizations    Json? // Custom subcategories or modifications
  status            String   @default("Draft")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  aiSystem          AISystem @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)

  @@index([aiSystemId])
  @@index([profileType])
  @@index([status])
}

model AIRMFRiskActivity {
  id                 String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  aiSystemId         String
  activityType       String // Risk_Identification, Risk_Analysis, Risk_Evaluation, Risk_Treatment, Risk_Monitoring
  relatedFunction    String? // GOVERN, MAP, MEASURE, MANAGE
  relatedCategory    String? // Category ID
  relatedSubcategory String? // Subcategory ID
  description        String    @db.Text
  riskLevel          String // Critical, High, Medium, Low
  status             String    @default("Open") // Open, In_Progress, Mitigated, Accepted, Transferred
  mitigationPlan     String?   @db.Text
  ownerId            String?
  targetDate         DateTime?
  completedDate      DateTime?
  evidence           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  aiSystem           AISystem  @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  owner              User?     @relation("AIRMFRiskActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([aiSystemId])
  @@index([activityType])
  @@index([relatedFunction])
  @@index([riskLevel])
  @@index([status])
  @@index([ownerId])
}

