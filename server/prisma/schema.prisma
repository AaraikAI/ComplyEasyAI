generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                         String                      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name                       String
  plan                       Plan                        @default(Foundation)
  stripeCustomerId           String?                     @unique
  stripeSubscriptionId       String?                     @unique
  subscriptionStatus         SubscriptionStatus          @default(trialing)
  billingCycle               BillingCycle                @default(annual)
  trialEndsAt                DateTime?
  subscriptionStartedAt      DateTime?
  subscriptionEndsAt         DateTime?
  cancelAtPeriodEnd          Boolean                     @default(false)
  activeAddOns               String[]                    @default([])
  usageMetrics               Json?
  parentOrganizationId       String?
  isParent                   Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @default(now()) @updatedAt
  webhooks                   Webhook[]
  webhookEvents              WebhookEvent[]
  accessReviews              AccessReview[]
  auditLogs                  AuditLog[]
  frameworks                 ComplianceFramework[]
  monitors                   ContinuousMonitor[]
  reports                    CustomReport[]
  integrations               Integration[]
  issues                     Issue[]
  parentOrganization         Organization?               @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations         Organization[]              @relation("OrgHierarchy")
  personnel                  Personnel[]
  policies                   Policy[]
  questionnaires             Questionnaire[]
  riskAssessments            RiskAssessment[]
  risks                      RiskItem[]
  trustCertificates          TrustCertificate[]
  users                      User[]
  vendors                    Vendor[]
  complianceGoals            ComplianceGoal[]
  controlLoops               ControlLoop[]
  controlLoopHistory         ControlLoopHistory[]
  complianceDebts            ComplianceDebt[]
  aiSuggestions              AISuggestion[]
  featureSubscriptions       FeatureSubscription[]
  changeImpacts              ChangeImpact[]
  agenticActions             AgenticAction[]
  evidenceAnalyses           EvidenceAnalysis[]
  regulatoryChanges          RegulatoryChange[]
  regulatoryFeeds            RegulatoryFeed[]
  riskPredictions            RiskPrediction[]
  vrTrainingScenarios        VRTrainingScenario[]
  vrTrainingSessions         VRTrainingSession[]
  vrCollaborativeSessions    VRCollaborativeSession[]
  neuroSymbolicReasonings    NeuroSymbolicReasoning[]
  ruleInferences             RuleInference[]
  federatedSwarmPeers        FederatedSwarmPeer[]
  federatedSwarmAggregations FederatedSwarmAggregation[]
  notifications              Notification[]
  complianceTrajectories     ComplianceTrajectory[]
  simulationScenarios        SimulationScenario[]
  simulationResults          SimulationResult[]
  redTeamResults             RedTeamResult[]
  swarmInsights              SwarmInsight[]
  iotDevices                 IoTDevice[]
  edgeComplianceChecks       EdgeComplianceCheck[]
  transcriptionResults       TranscriptionResult[]
  deviceTrusts               DeviceTrust[]
  zeroTrustPolicies          ZeroTrustPolicy[]
  networkSegments            NetworkSegment[]
  keyUsages                  KeyUsage[]
  keyRotationPolicies        KeyRotationPolicy[]
  compliancePolicies         CompliancePolicy[]
  chatConversations          ChatConversation[]
  aiSystems                  AISystem[]
  euAiActSystems             EUAIActSystem[]
  euAiActTransparencyReports EUAIActTransparencyReport[]
  dmaGatekeepers             DMAGatekeeper[]
  dsaPlatforms               DSAPlatform[]

  @@index([stripeCustomerId])
  @@index([parentOrganizationId])
}

model User {
  id                       String                  @id @default(dbgenerated("(uuid_generate_v4())::text"))
  email                    String                  @unique
  name                     String
  role                     Role                    @default(viewer)
  avatar                   String?
  passwordHash             String?
  emailVerified            Boolean                 @default(false)
  lastLogin                DateTime?
  employeeId               String?                 @unique
  department               String?
  jobTitle                 String?
  manager                  String?
  startDate                DateTime?
  endDate                  DateTime?
  active                   Boolean                 @default(true)
  twoFactorEnabled         Boolean                 @default(false)
  twoFactorSecret          String?
  twoFactorVerified        Boolean                 @default(false)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @default(now()) @updatedAt
  organizationId           String
  accessReviewsReviewer    AccessReview[]          @relation("Reviewer")
  auditLogs                AuditLog[]
  assignedIssues           Issue[]                 @relation("AssignedTo")
  createdIssues            Issue[]                 @relation("CreatedBy")
  personnelRecord          Personnel?
  assignedRisks            RiskItem[]
  backupCodes              TwoFactorBackupCode[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  ownedControls            FrameworkControl[]
  uploadedEvidenceVersions EvidenceVersion[]
  aiSuggestions            AISuggestion[]
  chatConversations        ChatConversation[]
  aiRmfSubcategoryOwner    AIRMFSubcategory[]      @relation("AIRMFSubcategoryOwner")
  aiRmfActorUser           AIRMFActor[]            @relation("AIRMFActorUser")
  aiRmfRiskActivityOwner   AIRMFRiskActivity[]     @relation("AIRMFRiskActivityOwner")
  organization             Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@index([employeeId])
}

model TwoFactorBackupCode {
  id        String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  code      String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

model Personnel {
  id                  String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId              String         @unique
  organizationId      String
  onboardingStatus    String         @default("Not_Started")
  onboardingDate      DateTime?
  offboardingDate     DateTime?
  offboardingReason   String?
  systemAccess        Json?
  dataAccess          Json?
  physicalAccess      Json?
  backgroundCheck     Boolean        @default(false)
  backgroundCheckDate DateTime?
  securityTraining    Boolean        @default(false)
  trainingDate        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt
  accessReviews       AccessReview[]
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model AccessReview {
  id             String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  personnelId    String
  reviewerId     String
  status         AccessReviewStatus @default(Pending)
  dueDate        DateTime
  completedDate  DateTime?
  findings       Json?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personnel      Personnel          @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  reviewer       User               @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([organizationId])
  @@index([personnelId])
  @@index([status])
}

model Vendor {
  id                 String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name               String
  organizationId     String
  website            String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  riskLevel          VendorRiskLevel    @default(Medium)
  riskScore          Int                @default(0)
  status             VendorStatus       @default(Onboarding)
  category           String?
  serviceDescription String?
  contractStart      DateTime?
  contractEnd        DateTime?
  annualSpend        Float?
  hasDataAccess      Boolean            @default(false)
  dataTypes          Json?
  securityContact    String?
  lastSecurityReview DateTime?
  nextSecurityReview DateTime?
  soc2Report         Boolean            @default(false)
  iso27001Certified  Boolean            @default(false)
  gdprCompliant      Boolean            @default(false)
  hipaaBaa           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessments        VendorAssessment[]
  monitors           VendorMonitor[]
  reviews            VendorReview[]

  @@index([organizationId])
  @@index([status])
  @@index([riskLevel])
}

model VendorAssessment {
  id              String           @id @default(dbgenerated("(uuid_generate_v4())::text"))
  vendorId        String
  assessmentType  String
  status          String           @default("In_Progress")
  score           Int?
  riskLevel       VendorRiskLevel?
  findings        Json?
  recommendations String?
  assessedBy      String?
  assessedDate    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorReview {
  id             String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  vendorId       String
  reviewType     String
  reviewDate     DateTime
  reviewer       String
  findings       Json?
  actionItems    Json?
  nextReviewDate DateTime?
  createdAt      DateTime  @default(now())
  vendor         Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorMonitor {
  id          String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  vendorId    String
  monitorType String
  status      MonitorStatus @default(Unknown)
  lastCheck   DateTime?
  findings    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  vendor      Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
}

model RiskAssessment {
  id               String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId   String
  name             String
  description      String?
  assessmentType   String
  scope            String?
  methodology      String?
  status           String       @default("Draft")
  startDate        DateTime?
  completedDate    DateTime?
  overallRiskScore Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risks            RiskItem[]   @relation("AssessmentRisks")

  @@index([organizationId])
  @@index([status])
}

model ComplianceFramework {
  id                     String                 @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name                   String
  status                 ComplianceStatus       @default(In_Review)
  progress               Int                    @default(0)
  nextAuditDate          DateTime
  region                 String?
  notes                  String?                @db.Text
  version                Int                    @default(1) // For concurrent edit tracking
  lastModifiedBy         String?
  lastModifiedAt         DateTime?              @updatedAt
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @default(now()) @updatedAt
  organizationId         String
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controls               FrameworkControl[]
  complianceDebts        ComplianceDebt[]
  complianceTrajectories ComplianceTrajectory[]
  aiSuggestions          AISuggestion[]

  @@index([organizationId])
  @@index([status])
}

model FrameworkControl {
  id               String              @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name             String
  description      String?
  status           String              @default("Pending")
  evidence         String?
  evidenceRequired Boolean             @default(false)
  ownerId          String?
  category         String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt
  frameworkId      String
  mappedControls   Json?
  framework        ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  owner            User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  controlLoops     ControlLoop[]
  complianceDebts  ComplianceDebt[]    @relation("ComplianceDebtControl")
  sourceMappings   ControlMapping[]    @relation("SourceMappings")
  targetMappings   ControlMapping[]    @relation("TargetMappings")
  evidenceVersions EvidenceVersion[]
  aiSuggestions    AISuggestion[]

  @@index([frameworkId])
  @@index([ownerId])
}

model RiskItem {
  id               String           @id @default(dbgenerated("(uuid_generate_v4())::text"))
  title            String
  severity         RiskSeverity
  description      String
  category         String
  status           RiskStatus       @default(Open)
  likelihood       Int              @default(3)
  impact           Int              @default(3)
  riskScore        Int?
  aiPriorityScore  Int?
  aiRationale      String?
  mitigationPlan   String?
  remediationOwner String?
  targetDate       DateTime?
  detectedAt       DateTime         @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  organizationId   String
  assignedToId     String?
  assessmentId     String?
  assessment       RiskAssessment?  @relation("AssessmentRisks", fields: [assessmentId], references: [id])
  assignedTo       User?            @relation(fields: [assignedToId], references: [id])
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  riskPredictions  RiskPrediction[]

  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([assignedToId])
  @@index([assessmentId])
}

model Questionnaire {
  id                String                  @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId    String
  title             String
  description       String?
  questionnaireType String
  status            QuestionnaireStatus     @default(Draft)
  requestedBy       String?
  requestDate       DateTime?
  dueDate           DateTime?
  aiAssisted        Boolean                 @default(false)
  aiConfidence      Float?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @default(now()) @updatedAt
  completedAt       DateTime?
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  questions         QuestionnaireQuestion[]
  responses         QuestionnaireResponse[]

  @@index([organizationId])
  @@index([status])
}

model QuestionnaireQuestion {
  id              String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  questionnaireId String
  questionText    String
  questionType    String
  category        String?
  required        Boolean       @default(false)
  options         Json?
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
}

model QuestionnaireResponse {
  id              String        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  questionnaireId String
  questionId      String
  responseText    String?
  responseData    Json?
  aiGenerated     Boolean       @default(false)
  aiConfidence    Float?
  reviewedByHuman Boolean       @default(false)
  attachments     Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
  @@index([questionId])
}

model Policy {
  id              String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId  String
  title           String
  policyNumber    String?
  version         String       @default("1.0")
  category        String
  framework       String?
  content         String
  summary         String?
  status          String       @default("Draft")
  owner           String?
  approver        String?
  approvalDate    DateTime?
  effectiveDate   DateTime?
  reviewDate      DateTime?
  nextReviewDate  DateTime?
  tags            Json?
  relatedPolicies Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([framework])
}

model TrustCertificate {
  id                String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId    String
  certificateType   String
  certificateNumber String?
  issuer            String
  issueDate         DateTime
  expiryDate        DateTime
  status            String       @default("Valid")
  documentUrl       String?
  publiclyVisible   Boolean      @default(false)
  metadata          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model CustomReport {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  name           String
  description    String?
  reportType     String
  template       Json
  filters        Json?
  schedule       Json?
  lastGenerated  DateTime?
  nextGeneration DateTime?
  recipients     Json?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([reportType])
}

model ContinuousMonitor {
  id             String          @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  name           String
  monitorType    String
  integrationId  String?
  configuration  Json
  testScript     String?
  status         MonitorStatus   @default(Unknown)
  lastRun        DateTime?
  nextRun        DateTime?
  frequency      String          @default("Daily")
  findings       Json?
  alerts         Json?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  results        MonitorResult[]

  @@index([organizationId])
  @@index([status])
  @@index([monitorType])
}

model MonitorResult {
  id                 String            @id @default(dbgenerated("(uuid_generate_v4())::text"))
  monitorId          String
  status             MonitorStatus
  runDate            DateTime          @default(now())
  passedTests        Int               @default(0)
  failedTests        Int               @default(0)
  findings           Json?
  evidence           Json?
  autoRemediated     Boolean           @default(false)
  remediationActions Json?
  monitor            ContinuousMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([status])
}

model Issue {
  id               String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId   String
  title            String
  description      String
  issueType        String
  category         String?
  priority         IssuePriority  @default(Medium)
  status           IssueStatus    @default(Open)
  assignedToId     String?
  createdById      String
  slaTarget        DateTime?
  slaStatus        String?
  remediationPlan  String?
  remediationSteps Json?
  dueDate          DateTime?
  resolvedDate     DateTime?
  closedDate       DateTime?
  tags             Json?
  attachments      Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  assignedTo       User?          @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy        User           @relation("CreatedBy", fields: [createdById], references: [id])
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments         IssueComment[]

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
}

model IssueComment {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  issueId   String
  comment   String
  author    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model AuditLog {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  action         String
  details        String?
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  hash           String       @unique
  verified       Boolean      @default(true)
  timestamp      DateTime     @default(now())
  organizationId String
  userId         String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([timestamp])
  @@index([hash])
  @@index([action])
  @@index([resourceType])
  @@index([userId])
}

model Integration {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  name           String
  category       String
  provider       String
  connected      Boolean      @default(false)
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  lastSync       DateTime?
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model MagicLink {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

model FileUpload {
  id             String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  filename       String
  originalName   String
  mimeType       String
  size           Int
  s3Key          String   @unique
  s3Bucket       String
  url            String
  uploadedBy     String
  organizationId String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([uploadedBy])
  @@index([s3Key])
}

model StripeEvent {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  eventId   String   @unique
  type      String
  data      Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([type])
  @@index([processed])
}

enum Role {
  admin
  editor
  viewer
  compliance_admin
  security_admin
}

enum ComplianceStatus {
  Compliant
  At_Risk
  Non_Compliant
  In_Review
}

enum RiskSeverity {
  Critical
  High
  Medium
  Low
}

enum RiskStatus {
  Open
  In_Progress
  Resolved
  Ignored
  Accepted
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
  incomplete
  incomplete_expired
  unpaid
}

enum BillingCycle {
  monthly
  annual
}

enum Plan {
  Basic // Legacy value - will be migrated
  Pro // Legacy value - will be migrated
  Enterprise // Legacy value - will be migrated
  Foundation
  Essentials
  Growth
  Visionary
}

enum AccessReviewStatus {
  Pending
  In_Progress
  Completed
  Overdue
}

enum VendorRiskLevel {
  Critical
  High
  Medium
  Low
}

enum VendorStatus {
  Active
  Inactive
  Onboarding
  Offboarding
  Suspended
}

enum QuestionnaireStatus {
  Draft
  In_Progress
  Completed
  Reviewed
  Approved
}

enum IssueStatus {
  Open
  In_Progress
  Resolved
  Closed
  Reopened
}

enum IssuePriority {
  Critical
  High
  Medium
  Low
}

enum MonitorStatus {
  Passing
  Failing
  Warning
  Unknown
}

// aCOS v3.0 Models
model ComplianceGoal {
  id               String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId   String
  name             String?
  goalType         String
  frameworks       String[]
  riskTolerance    String
  horizon          Int
  autoActionPolicy String
  targetScore      Int?
  deadline         DateTime?
  status           String       @default("active")
  createdBy        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model ControlLoop {
  id             String               @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  controlId      String
  observeAgent   String
  actAgent       String
  verifyAgent    String
  confidence     Float                @default(0.5)
  status         String               @default("active")
  lastObserved   DateTime             @default(now())
  lastActed      DateTime             @default(now())
  lastVerified   DateTime             @default(now())
  cycleCount     Int                  @default(0)
  triggerType    String?              @default("manual")
  triggerConfig  Json?
  timeoutSeconds Int?                 @default(300)
  parentLoopId   String?
  configuration  Json?
  lastError      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control        FrameworkControl     @relation(fields: [controlId], references: [id], onDelete: Cascade)
  history        ControlLoopHistory[]

  @@index([organizationId])
  @@index([controlId])
  @@index([status])
  @@index([triggerType])
  @@index([parentLoopId])
}

model ControlLoopHistory {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  loopId         String
  organizationId String
  executionPhase String
  phaseResult    Json
  durationMs     Int
  success        Boolean      @default(true)
  error          String?
  timestamp      DateTime     @default(now())
  loop           ControlLoop  @relation(fields: [loopId], references: [id], onDelete: Cascade)
