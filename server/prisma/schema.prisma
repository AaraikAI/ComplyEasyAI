  type        String          // METRIC_CARD, LINE_CHART, BAR_CHART, etc.
  title       String
  config      Json?
  position    Json?           // x, y, width, height
  dashboard   CustomDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

// ── 6.1 Report Builder ───────────────────────────────────────────────
model ReportTemplate {
  id              String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId  String
  name            String
  description     String?
  sections        Json?
  filters         Json?
  schedule        String?
  recipients      String[]     @default([])
  format          String       @default("PDF")
  lastGeneratedAt DateTime?
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ── 5.2 CI/CD Compliance Gates ───────────────────────────────────────
model CICDGatePolicy {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  name           String
  description    String?
  rules          Json?        // Required checks, policies
  isActive       Boolean      @default(true)
  results        CICDGateResult[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CICDGateResult {
  id         String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  policyId   String
  repository String
  branch     String
  commitHash String
  status     String         // PASSED, FAILED, SKIPPED
  details    Json?
  triggeredAt DateTime      @default(now())
  policy     CICDGatePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([repository])
}

// ── 1.3 Search Index ─────────────────────────────────────────────────
model SearchIndex {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  resourceType   String
  resourceId     String
  title          String
  content        String
  metadata       Json?
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resourceType])
  @@index([organizationId])
}

// ── 4.11 Vendor Continuous Monitoring ────────────────────────────────
model VendorMonitoringCheck {
  id             String       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  organizationId String
  vendorId       String
  checkType      String       // domain_reputation, ssl_check, breach_check, soc2_expiry
  status         String       // PASS, WARN, FAIL
  details        Json?
  checkedAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vendorId])
  @@index([checkedAt])
}
