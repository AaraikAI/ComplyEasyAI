# Test Environment Variables
# Copy this file to .env.test for local test execution
# These values are used by the test setup in src/__tests__/setup.ts

# Database Configuration
DATABASE_URL="postgresql://test:test@localhost:5432/test_db"

# JWT Configuration
JWT_SECRET="test-jwt-secret-key-for-testing-purposes-only-min-32-chars"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="test-refresh-secret-key-for-testing-purposes-only-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption
ENCRYPTION_KEY="test-encryption-key-32-chars-minimum-length-required!!!"

# API Keys (test values)
GEMINI_API_KEY="test-gemini-key"
STRIPE_SECRET_KEY="sk_test_fake"
SENDGRID_API_KEY="SG.test"
SENDGRID_FROM_EMAIL="test@example.com"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Logging
LOG_LEVEL="error"
NODE_ENV="test"

# Optional: Advanced Features (for integration tests)
# BLOCKCHAIN_PRIVATE_KEY="0x" + "1".repeat(64)
# COMPLIANCE_CONTRACT_ADDRESS="0x" + "2".repeat(40)
# ETHEREUM_RPC_URL="https://test-rpc.com"
# POLYGON_RPC_URL="https://test-polygon-rpc.com"

# AWS KMS (for BYOK tests)
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="test-key"
# AWS_SECRET_ACCESS_KEY="test-secret"

# Azure Key Vault (for BYOK tests)
# AZURE_TENANT_ID="test-tenant"
# AZURE_CLIENT_ID="test-client"
# AZURE_CLIENT_SECRET="test-secret"

# Sentry (optional for tests)
# SENTRY_ENABLED="false"
# SENTRY_DSN=""

# Elasticsearch (optional for tests)
# ELASTICSEARCH_URL="http://localhost:9200"

