{
  "name": "complyeasy-server",
  "version": "2.0.0",
  "description": "ComplyEasy AI Enterprise Backend Server with 10 Enterprise Modules + 5 Visionary AI Features",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 jest",
    "test:watch": "NODE_OPTIONS=--max-old-space-size=4096 jest --watch",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=4096 jest --coverage",
    "test:ci": "NODE_OPTIONS=--max-old-space-size=4096 jest --ci --coverage --reporters=default --reporters=jest-junit",
    "test:unit": "NODE_OPTIONS=--max-old-space-size=4096 jest --testPathPattern=__tests__/unit",
    "test:integration": "NODE_OPTIONS=--max-old-space-size=4096 jest --testPathPattern=__tests__/integration",
    "test:e2e": "NODE_OPTIONS=--max-old-space-size=4096 jest --testPathPattern=__tests__/e2e",
    "test:all": "NODE_OPTIONS=--max-old-space-size=4096 jest --testPathPattern='__tests__/(unit|integration|e2e)'",
    "test:single": "NODE_OPTIONS=--max-old-space-size=4096 jest --runInBand",
    "test:performance": "NODE_OPTIONS=--max-old-space-size=4096 jest --testPathPattern=__tests__/performance",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "setup:oauth": "ts-node scripts/setupOAuth.ts",
    "validate:env": "ts-node scripts/validateEnv.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:fix": "npm audit fix",
    "security:check": "node scripts/security-audit.js",
    "performance:load": "node scripts/load-test.js",
    "performance:profile": "node scripts/profile-queries.js",
    "performance:test": "ts-node scripts/performance-test.ts",
    "performance:optimize": "ts-node scripts/optimize-endpoints.ts",
    "test:coverage:check": "npm run test:coverage && node -e \"const fs=require('fs');const cov=JSON.parse(fs.readFileSync('coverage/coverage-summary.json'));const total=cov.total.lines.pct;console.log('Coverage:',total+'%');process.exit(total>=80?0:1);\"",
    "zkp:compile": "bash scripts/compile-circuits.sh",
    "zkp:setup": "bash scripts/trusted-setup.sh",
    "opa:deploy": "cd docker/opa && docker-compose up -d",
    "opa:stop": "cd docker/opa && docker-compose down"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.699.0",
    "@aws-sdk/client-rekognition": "^3.958.0",
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-keys": "^4.9.1",
    "@google-cloud/kms": "^5.2.1",
    "@google-cloud/vision": "^5.3.4",
    "@google/generative-ai": "^0.21.0",
    "@grpc/grpc-js": "^1.14.3",
    "@hyperledger/fabric-gateway": "^1.10.0",
    "@hyperledger/fabric-protos": "^0.3.7",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.4",
    "@tensorflow/tfjs": "^4.21.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "aws-sdk": "^2.1691.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fabric-network": "^2.2.20",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^144.0.0",
    "graphology": "^0.25.4",
    "graphology-layout": "^0.5.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "helmet": "^8.0.0",
    "inquirer": "^8.2.6",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-seal": "^5.1.1",
    "node-vault": "^0.10.9",
    "ntp-client": "^0.5.3",
    "openai": "^4.47.1",
    "paillier-bigint": "^3.4.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "snarkjs": "^0.7.5",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "stripe": "^17.5.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@octokit/rest": "^22.0.1",
    "@sentry/node": "^8.0.0",
    "@sentry/profiling-node": "^8.0.0",
    "@slack/web-api": "^7.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.3",
    "@types/ntp-client": "^0.5.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "circom": "^0.5.46",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
