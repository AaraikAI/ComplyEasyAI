{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./*"] },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["components/**/*", "services/**/*", "hooks/**/*", "contexts/**/*", "constants/**/*", "constants.ts", "*.tsx", "*.ts"],
  "exclude": ["server", "e2e", "**/__tests__/**", "**/*.test.*", "**/*.spec.*", "playwright.config.ts"]
}
